<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Enterprise Automation Parallel Suite" parallel="methods" thread-count="3" verbose="1">
    <listeners>
        <listener class-name="com.framework.utils.TestListener"/>
    </listeners>
    <test name="Chrome Parallel Regression Tests">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.framework.tests.LoginAndCheckoutTest"/>
        </classes>
    </test>
</suite>

